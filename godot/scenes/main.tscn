[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/maps/terminal.tscn" id="1_arena"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="3_hud"]
[ext_resource type="Script" path="res://scripts/player/top_down_camera.gd" id="4_camera"]
[ext_resource type="Script" path="res://scripts/systems/spawn_manager.gd" id="5_spawn"]
[ext_resource type="Script" path="res://scripts/systems/round_manager.gd" id="6_round"]
[ext_resource type="Script" path="res://scripts/systems/points_manager.gd" id="7_points"]
