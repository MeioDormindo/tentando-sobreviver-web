score_manager = NodePath("../ScoreManager")
anti_cheat = NodePath("../AntiCheat")

[node name="PowerUpSystem" type="Node" parent="." node_paths=PackedStringArray("player", "points_manager")]
script = ExtResource("21_powerups")
data = ExtResource("22_powerup_data")
