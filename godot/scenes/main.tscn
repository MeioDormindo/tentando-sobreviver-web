[node name="Main" type="Node3D"]

[node name="World" parent="." instance=ExtResource("1_arena")]

[node name="Player" parent="." node_paths=PackedStringArray("camera") instance=ExtResource("2_player")]
camera = NodePath("../Camera")

[node name="Camera" type="Camera3D" parent="." node_paths=PackedStringArray("target")]
current = true
fov = 50.0
script = ExtResource("4_camera")
target = NodePath("../Player")

[node name="Zombies" type="Node3D" parent="."]

[node name="SpawnManager" type="Node" parent="." node_paths=PackedStringArray("world", "container", "target")]
script = ExtResource("5_spawn")
zombie_data = ExtResource("10_walker")
world = NodePath("../World")
container = NodePath("../Zombies")
target = NodePath("../Player")

[node name="BossManager" type="Node" parent="." node_paths=PackedStringArray("spawn_manager")]
script = ExtResource("13_boss")
spawn_manager = NodePath("../SpawnManager")

[node name="RoundManager" type="Node" parent="." node_paths=PackedStringArray("spawn_manager", "boss_manager")]
script = ExtResource("6_round")
data = ExtResource("11_rounds")
spawn_manager = NodePath("../SpawnManager")
boss_manager = NodePath("../BossManager")

[node name="PointsManager" type="Node" parent="."]
script = ExtResource("7_points")
data = ExtResource("12_points")

[node name="GameManager" type="Node" parent="." node_paths=PackedStringArray("player", "arena", "round_manager", "points_manager")]
script = ExtResource("8_game")
player = NodePath("../Player")
arena = NodePath("../World")
round_manager = NodePath("../RoundManager")
points_manager = NodePath("../PointsManager")

[node name="AudioManager" type="Node" parent="."]
script = ExtResource("9_audio")

[node name="HUD" parent="." instance=ExtResource("3_hud")]
