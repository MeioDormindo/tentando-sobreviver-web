[node name="MinimapFeed" type="Node" parent="." node_paths=PackedStringArray("world", "player")]
script = ExtResource("24_minimap")
world = NodePath("../World")
player = NodePath("../Player")

[node name="AchievementSystem" type="Node" parent="." node_paths=PackedStringArray("anti_cheat")]
