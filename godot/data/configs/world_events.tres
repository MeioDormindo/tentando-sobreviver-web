&"rise_of_dead": { "name": "LEVANTE DOS MORTOS", "hint": "Os sarcófagos se abrem — esqueletos saindo!", "color": Color(0.812, 0.776, 0.667, 1), "weight": 16, "min_round": 3, "cooldown_rounds": 2 },
&"artemis_hunt": { "name": "CAÇADA DE ARTEMIS", "hint": "Sátiros e lobos infernais estão caçando você", "color": Color(0.478, 0.824, 0.478, 1), "weight": 14, "min_round": 6, "cooldown_rounds": 3 },
&"underworld_portal": { "name": "PORTÃO DO SUBMUNDO", "hint": "Um portal solta criaturas — destrua-o a tiros", "color": Color(0.651, 0.416, 1, 1), "weight": 10, "min_round": 8, "cooldown_rounds": 4 },
