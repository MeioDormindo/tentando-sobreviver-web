&"blood_moon": { "name": "LUA DE SANGUE", "hint": "Zumbis mais rápidos — dinheiro e pontos em dobro", "color": Color(0.816, 0.204, 0.173, 1), "weight": 12, "min_round": 5, "cooldown_rounds": 4 },
&"collapse": { "name": "DESABAMENTO", "hint": "O teto está caindo: saia dos círculos vermelhos!", "color": Color(0.784, 0.706, 0.541, 1), "weight": 14, "min_round": 4, "cooldown_rounds": 3 },
