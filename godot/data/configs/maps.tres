"temple": { "name": "Templo dos Mortos", "description": "Ruínas gregas, uma necrópole, a floresta de Artemis e o portão para o Submundo.", "scene": "res://scenes/maps/temple.tscn", "unlock_boss_round": 0, "unlock_on_map": "", "unlock_achievements": ["last_train", "serum"] }
