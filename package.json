{
  "name": "tentando-sobreviver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "art": "node scripts/generate-art.mjs",
    "godot:data": "esbuild scripts/godot/export-data.ts --bundle --platform=node --format=esm --log-level=warning --external:@resvg/resvg-js --outfile=node_modules/.cache/godot-export.mjs && node node_modules/.cache/godot-export.mjs",
    "godot:audio": "esbuild scripts/godot/export-audio.ts --bundle --platform=node --format=esm --log-level=warning --alias:phaser=./scripts/godot/phaser-stub.ts --outfile=node_modules/.cache/godot-audio.mjs && node node_modules/.cache/godot-audio.mjs",
    "godot:sprites": "node scripts/godot/pixel/build.mjs",
    "godot:scenery": "node scripts/godot/pixel/scenery.mjs",
    "godot:maps": "esbuild scripts/godot/maps/build.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/godot-maps.mjs && node node_modules/.cache/godot-maps.mjs",
    "godot:font": "node scripts/godot/pixel/font.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
